#!/bin/bash

set -u

# Launcher script for Raspberry Pi.
# Responsibilities:
# 1) Run launch.py from the prepared venv.
# 2) Restart on crashes unless manually cancelled.

logprefix="[launch]"
log() {
    echo "$logprefix $*"
}

fail() {
    log "$*"
    exit 1
}

DIR="/bro"
APP_DIR="${DIR}/app"
LAUNCHER_DIR="${APP_DIR}/launcher"
VENV_DIR="${DIR}/.venv"
VENV_PYTHON="${VENV_DIR}/bin/python"
EXIT_CODE_ALREADY_RUNNING=200
REBOOT_PENDING_FLAG_PATH="/bro/brosmarttv-reboot-pending.flag"
RESTART_TIMEOUT=5

export QT_QPA_PLATFORM=eglfs
export QT_QPA_EGLFS_KMS_CONFIG="${LAUNCHER_DIR}/eglfs_kms_conf.json"

# Widevine CDM binary isn't provisioned by any script (see broSmartTV/WEB_INTEGRATION.md) -
# if one is ever manually placed at this path, DRM playback activates with no further script changes.
WIDEVINE_CDM_PATH="${DIR}/widevine/libwidevinecdm.so"
if [ -f "${WIDEVINE_CDM_PATH}" ]; then
    export QTWEBENGINE_CHROMIUM_FLAGS="--widevine-path=${WIDEVINE_CDM_PATH}"
fi
if [ "${BRO_WEBENGINE_DISABLE_GPU:-}" = "1" ]; then
    export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:-} --disable-gpu --disable-gpu-compositing"
fi
# Ensure runtime imports come from /bro/.venv and not ~/.local user-site.
export PYTHONNOUSERSITE=1
unset PYTHONPATH

main() {
    log "Starting launch script..."

    cd "${DIR}" || fail "Directory not found: ${DIR}"

    [ -x "${VENV_PYTHON}" ] || \
        fail "Missing ${VENV_PYTHON}. Run the install script first."
    [ -f "${APP_DIR}/py/launch.py" ] || \
        fail "Missing ${APP_DIR}/py/launch.py. Run the install script first."

    # Git checkouts made on non-Linux hosts can lose executable bits. Repair
    # the updater before Python starts so launch.py can always run it on Pi.
    chmod a+x "${LAUNCHER_DIR}/update" || \
        fail "Failed to make ${LAUNCHER_DIR}/update executable."

    log "Using Python executable: ${VENV_PYTHON}"
    "${VENV_PYTHON}" -c "import sys; print('${logprefix} Python sys.executable:', sys.executable)"

    while true; do
        "${VENV_PYTHON}" "${APP_DIR}/py/launch.py"
        exit_code=$?

        if [ -e "${REBOOT_PENDING_FLAG_PATH}" ]; then
            log "App requested a device reboot; not restarting."
            exit 1
        fi

        if [ $exit_code -eq 130 ]; then
            log "Launch script was manually cancelled; not restarting."
            exit 1
        fi

        if [ $exit_code -eq $EXIT_CODE_ALREADY_RUNNING ]; then
            log "Another launcher instance is already running; aborting."
            exit 1
        fi

        log "launch.py exited with code ${exit_code}; restarting in ${RESTART_TIMEOUT}s..."
        sleep "${RESTART_TIMEOUT}"
    done
}

main
